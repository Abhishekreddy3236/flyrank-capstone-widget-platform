# Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://flyrank:flyrank_secret@localhost:5432/flyrank_capstone

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# CORS - comma-separated allowed origins
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Geo Providers
GEO_PROVIDER_A_URL=http://ip-api.com/json
GEO_PROVIDER_B_URL=https://ipapi.co

# Side Effect (email simulation)
SIDE_EFFECT_MODE=console

# Worker
WORKER_POLL_INTERVAL_MS=2000
WORKER_MAX_RETRIES=3

# Widget config cache TTL (seconds)
WIDGET_CONFIG_CACHE_TTL=300
